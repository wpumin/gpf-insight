rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read/write for NAV History
    // (In production, write should be restricted to a server-side service account)
    match /nav_history/{docId} {
      allow read, write: if true;
    }

    // Allow public read/write for metadata (sync info)
    match /metadata/{docId} {
      allow read, write: if true;
    }

    // Allow connection test
    match /test/connection {
      allow read: if true;
    }
  }
}
