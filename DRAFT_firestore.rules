rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "pumin.wo@gmail.com"
      );
    }

    // NAV History - Publicly readable, writeable by anyone (simplified for dev)
    // In production, write should be restricted to a service account or admin
    match /nav_history/{dateId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Allow for now so sync task works
    }

    // Market Indices - Publicly readable, writeable by admin or sync task
    match /market_indices/{indexId} {
      allow read: if true;
      allow write: if isAdmin() || true; 
    }

    // User Portfolios - Private to the user
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Metadata - Sync info
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
    
    // Connection test
    match /test/connection {
      allow read: if true;
    }
  }
}
